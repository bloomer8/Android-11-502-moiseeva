lse" aria-label="Показать полностью" tabindex="0" data-counter="[&quot;b&quot;]" data-log-node="2_h7ajw0f-0-32i" target="_blank" role="button"><span class="FactFold-ButtonContent"><svg xmlns="http://www.w3.org/2000/svg" width="1rem" height="1rem" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="FactFold-Icon"><path d="M8 9.585l4.793-4.79a1 1 0 011.414 1.415l-5.5 5.496a1 1 0 01-1.414 0l-5.5-5.496a1 1 0 011.414-1.415L8 9.585z"></path></svg></span></span></div></div><div class="FactFold-Divider FactFold-Divider_folded"></div><section class="FuturisGPTMessage-GroupSources"><h3 class="A11yHidden">8 источников</h3><div class="Scroller Scroller_sameHeight Scroller_scrollDirection_right Scroller_hasArrows Scroller_hasArrows Scroller_smallerArrows Scroller_theme_futuris FuturisGPTMessage-Sources FuturisGPTMessage-Sources_wrapper_scroller" data-log-node="2_h7ajw0f-0-32j"><div class="Scroller-Container"><div class="ArrowButton ArrowButton_direction_left ArrowButton_hidden ArrowButton_withShadows Scroller-Arrow"></div><ol class="Scroller-Wrap"><div class="Scroller-ItemsWrap"><li class="FuturisGPTMessage-SourcesItem"><a class="Link Link_theme_normal FuturisSource FuturisSource_compact" theme="normal" href="https://ru.wikipedia.org/wiki/%D0%A1%D0%B2%D0%B8%D1%84%D1%82,_%D0%A2%D0%B5%D0%B9%D0%BB%D0%BE%D1%80" data-counter="[&quot;b&quot;]" data-log-node="2_h7ajw0f-0-32l" target="_blank"><div class="FuturisSource-Path"><div class="FuturisSource-IconWrap"><i class="FuturisSource-Icon" style="background-image:url(https://favicon.yandex.net/favicon/v2/https://ru.wikipedia.org?size=32&amp;stub=1)"></i></div><div class="OneLine FuturisSource-Host">ru.wikipedia.org</div></div></a></li><li class="FuturisGPTMessage-SourcesItem"><a class="Link Link_theme_normal FuturisSource FuturisSource_compact" theme="normal" href="https://www.rbc.ru/person/66608cb19a79476f0c08d6e4" data-counter="[&quot;b&quot;]" data-log-node="2_h7ajw0f-0-32m" target="_blank"><div class="FuturisSource-Path